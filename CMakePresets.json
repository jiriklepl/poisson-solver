{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-shared",
      "hidden": true,
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base-shared",
      "description": "Debug build without MPI support",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_MPI": "OFF"
      }
    },
    {
      "name": "debug-mpi",
      "inherits": "base-shared",
      "description": "Debug build with MPI support",
      "binaryDir": "${sourceDir}/build-debug-mpi",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_MPI": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base-shared",
      "description": "Release build without MPI support",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_MPI": "OFF"
      }
    },
    {
      "name": "release-mpi",
      "inherits": "base-shared",
      "description": "Release build with MPI support",
      "binaryDir": "${sourceDir}/build-release-mpi",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_MPI": "ON"
      }
    }
  ]
}
