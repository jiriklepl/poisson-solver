{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-shared",
      "hidden": true,
      "$comment": "PoisFFT builds shared libs by default, so do we",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "POISSON_SOLVER_BUILD_FORTRAN": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base-shared",
      "description": "Debug build without MPI support",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "POISSON_SOLVER_USE_MPI": "OFF"
      }
    },
    {
      "name": "debug-mpi",
      "inherits": "base-shared",
      "description": "Debug build with MPI support",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "POISSON_SOLVER_USE_MPI": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base-shared",
      "description": "Release build without MPI support",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "POISSON_SOLVER_USE_MPI": "OFF"
      }
    },
    {
      "name": "release-mpi",
      "inherits": "base-shared",
      "description": "Release build with MPI support",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "POISSON_SOLVER_USE_MPI": "ON"
      }
    },
    {
      "name": "release-benchmarks",
      "inherits": "release",
      "description": "Release build without MPI support, with the benchmarks target enabled",
      "cacheVariables": {
        "POISSON_SOLVER_ENABLE_BENCHMARKS": "ON"
      }
    },
    {
      "name": "release-mpi-benchmarks",
      "inherits": "release-mpi",
      "description": "Release build with MPI support, with the benchmarks target enabled",
      "cacheVariables": {
        "POISSON_SOLVER_ENABLE_BENCHMARKS": "ON"
      }
    }
  ]
}
